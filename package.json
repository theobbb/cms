		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.1",
		"@types/qrcode": "^1.5.6",
		"@types/ua-parser-js": "^0.7.39",
		"js-yaml": "^4.1.1",
		"prettier": "^3.8.1",
